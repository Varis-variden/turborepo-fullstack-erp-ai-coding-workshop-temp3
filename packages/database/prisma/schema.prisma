// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASING
  STAFF
  MANAGER
}

/// Why a stock balance changed. The ledger records one movement per change.
/// RECEIPT: goods received against a purchase order. SALE: stock sold at a store.
/// ADJUSTMENT: a manual correction (and the opening balances the seed lays down).
enum StockMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
}

/// Whether an audited action succeeded (POSTED) or was rejected (REJECTED). NFR-03.
enum AuditOutcome {
  POSTED
  REJECTED
}

/// A store is a distinct stock location. `code` is the business key used across the app
/// (e.g. "B01"); it is what `User.storeId` refers to.
model Store {
  id        String   @id @default(cuid())
  /// Unique across the organization, e.g. "B01".
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  reorderThresholds ProductReorderThreshold[]
  stockMovements    StockMovement[]
  stockBalances     StockBalance[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  auditLogs         AuditLog[]
}

/// A product is something the retailer buys and sells, with one base unit. `sku` is the business
/// key used across the app (e.g. "SKU001"). An inactive product stays in the database so historical
/// records can still find it, but it cannot be added to a new document.
model Product {
  id           String   @id @default(cuid())
  /// Unique across the organization, e.g. "SKU001".
  sku          String   @unique
  name         String
  category     String
  /// The base unit, e.g. "pack".
  unit         String
  /// Money is never a float: two decimals, THB.
  sellingPrice Decimal  @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  reorderThresholds  ProductReorderThreshold[]
  stockMovements     StockMovement[]
  stockBalances      StockBalance[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
}

/// The reorder threshold of one product in one store. Whole number, never negative (checked by
/// the contract); a store without a row has no threshold set.
model ProductReorderThreshold {
  productId String
  storeId   String
  threshold Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@id([productId, storeId])
}

/// A supplier is an organization a purchase order can be raised against. `code` is the business
/// key used across the app (e.g. "SUP01"). Contact details are optional.
model Supplier {
  id           String   @id @default(cuid())
  /// Unique across the organization, e.g. "SUP01".
  code         String   @unique
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  createdAt    DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STAFF)
  /// The store this user acts for. Null means all stores (MANAGER/ADMIN).
  storeId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The append-only stock-movement ledger: the source of truth for every balance change (INV-02).
/// One row per increase or decrease, recording the before/after balance, the movement type, the
/// source document it came from, who did it, and when. Rows are never edited or deleted; a
/// confirmed movement is immutable. The derived StockBalance is written in the same transaction.
model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  storeId        String
  /// Signed change: positive for a receipt, negative for a sale. Whole units.
  quantityChange Int
  /// The store balance for this product immediately before and after this movement.
  balanceBefore  Int
  balanceAfter   Int
  type           StockMovementType
  /// The document that caused the movement, e.g. "GR" / "SAL" / "ADJUSTMENT", plus its id.
  /// Nullable for the opening balances the seed lays down, which have no source document.
  sourceType     String?
  sourceId       String?
  /// The user who performed the action. Nullable for seed/opening movements.
  actorId        String?
  createdAt      DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([productId, storeId, createdAt])
}

/// The derived current quantity of one product in one store: a fast-read cache over the ledger.
/// Balance = opening + successful movements, never negative (INV-03). Written in the same
/// transaction as the movement that changes it, so it can never drift from the ledger.
model StockBalance {
  productId String
  storeId   String
  /// Current on-hand quantity. Whole units, never negative.
  quantity  Int    @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@id([productId, storeId])
}

/// Where a purchase order is in its life. Receipts move an APPROVED order to PARTIALLY_RECEIVED
/// while quantity is outstanding and to COMPLETED once every line is fully received (GR-03).
enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
}

/// The next number to hand out for each type of numbered document (`PO`, later `GR` and `SAL`).
/// One row per type; allocating bumps `lastValue` inside the transaction that creates the
/// document, so two concurrent creates can never be given the same number.
model DocumentSequence {
  /// The document type prefix, e.g. "PO".
  type      String @id
  /// The last sequence value handed out. 0 means none yet.
  lastValue Int    @default(0)
}

/// A purchase order refers to one supplier and one destination store. `number` is the unique
/// per-type sequential document number, e.g. "PO-001". Creating it does not change stock.
model PurchaseOrder {
  id                  String              @id @default(cuid())
  /// Unique across all purchase orders, e.g. "PO-001".
  number              String              @unique
  status              PurchaseOrderStatus @default(DRAFT)
  supplierId          String
  storeId             String
  /// A calendar date (no time of day).
  expectedReceiptDate DateTime            @db.Date
  /// The user who created it. Not a foreign key, like StockMovement.actorId.
  createdById         String?
  createdAt           DateTime            @default(now())

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  store    Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@index([createdAt])
}

/// One product line of a purchase order. `sku`, `productName`, `unit` and `unitPrice` are a
/// snapshot taken at creation, so later edits to the product never change a historical order.
/// `unitPrice` is the purchase price per unit (never negative; checked by the contract).
model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  sku             String
  productName     String
  unit            String
  /// Ordered quantity: a positive whole number (checked by the contract).
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines  GoodsReceiptLine[]

  /// A SKU appears at most once per order (PO-01).
  @@unique([purchaseOrderId, productId])
}

/// A confirmed goods receipt against an approved purchase order (GR-03). Confirming it allocates
/// the unique `GR-` `number`, increases the destination store's stock and appends the RECEIPT
/// movements in one transaction. `idempotencyKey` is a client-generated UUID, one per user action,
/// unique-constrained so the same action can never post twice (GR-04, NFR-03). Receipts are final:
/// never edited or deleted. `receivedById` is a plain string like StockMovement.actorId.
model GoodsReceipt {
  id              String   @id @default(cuid())
  /// Unique across all goods receipts, e.g. "GR-001".
  number          String   @unique
  idempotencyKey  String   @unique
  purchaseOrderId String
  /// The destination store of the order, kept here so receipts can be store-scoped.
  storeId         String
  receivedById    String
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  @@index([purchaseOrderId])
}

/// One received line of a goods receipt. `sku`, `productName` and `unit` are a snapshot taken at
/// confirmation, like the purchase-order line it fulfils. `quantity` is a positive whole number;
/// lines received at zero are not recorded.
model GoodsReceiptLine {
  id                  String @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String
  sku                 String
  productName         String
  unit                String
  quantity            Int

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
}

/// The audit log of sensitive actions (NFR-03): who did what, when, against which source
/// document, in which store, and with what outcome. Written in the same transaction as the
/// action it records (a stock adjustment, a goods receipt), so an audited action and its audit row
/// post together or roll back together. Rows are append-only: never edited or deleted. Reads are
/// restricted by permission and store scope. `storeId` is what store-scoped reads filter on;
/// `actorId` is a plain string like StockMovement.actorId, not a foreign key.
model AuditLog {
  id         String       @id @default(cuid())
  /// The audited action, e.g. "STOCK_ADJUSTMENT".
  action     String
  /// The user who performed the action.
  actorId    String
  /// The store the action happened in; store-scoped reads filter on this.
  storeId    String
  /// The document that the action refers to, e.g. "ADJUSTMENT" plus the movement id. `sourceId`
  /// is null when the action wrote no document (a rejected adjustment writes no movement).
  sourceType String
  sourceId   String?
  outcome    AuditOutcome
  /// A human-readable detail, e.g. the adjustment reason.
  detail     String?
  createdAt  DateTime     @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
}
